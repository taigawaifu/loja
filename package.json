
{
  "name": "loja",
  "version": "1.0.0",
  "description": "Uma loja completa para o meu avô",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:full": "npm run services:up && next dev",
    "build": "next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jest": "^29.6.2",
    "next": "^13.1.6",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
