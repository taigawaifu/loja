{
  "name": "loja",
  "version": "1.0.0",
  "description": "Uma loja completa para o meu avô",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:full": "npm run services:up && next dev && npm run wait-for-postgres",
    "build": "next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "npm run services:up && npm run wait-for-postgres && concurrently -n next,jest --hide next -k -s command-jest 'next dev' 'jest --runInBand'",
    "test:watch": "jest --watch --runInBand",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "wait-for-postgres": "node infra/scripts/wait-postgres.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "async-retry": "1.3.3",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "jest": "30.5.2",
    "next": "16.4.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.10"
  }
}
